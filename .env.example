# Variables opcionales heredadas de utilidades antiguas de Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Azure Blob Storage (no hace falta si IMAGE_STORAGE_MODE=local, ver abajo)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=imagenes-sentinel

# Modo de almacenamiento de imagenes para app.py: "azure" (default, produccion)
# o "local" (lee de una carpeta en disco en vez de Azure Blob Storage -- util
# para probar sin acceso a Azure; usar junto con descargar_local.py)
IMAGE_STORAGE_MODE=azure
LOCAL_IMAGES_DIR=Imagenes

# OneDrive / SharePoint Excel
PROJECT_METADATA_XLSX_URL=
PROJECT_METADATA_SHEET_NAME=proyectos_satview

# Copernicus / openEO
OPENEO_AUTH_METHOD=client_credentials
OPENEO_AUTH_CLIENT_ID=
OPENEO_AUTH_CLIENT_SECRET=
OPENEO_AUTH_PROVIDER_ID=CDSE
